generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String              @id @default(uuid())
  email             String?             @unique
  phone             String?             @unique
  password          String
  role              Role                @default(USER)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  name              String
  isActive          Boolean             @default(true)
  profileImage      String?
  brandId           String?
  brand             Brand?
  BrandFollow       BrandFollow[]
  CommissionSetting CommissionSetting[]
  merchantProfile   MerchantProfile?
  Order             Order[]
  Payout            Payout[]            @relation("MerchantPayouts")
  products          Product[]
  sales             Sale[]              @relation("MerchantSales")
  addresses         UserAddress[]
  userProfile       UserProfile?
}

model UserProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  firstName   String
  lastName    String
  dateOfBirth DateTime
  email       String
  phone       String
  country     String
  address     String
  zipCode     String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserAddress {
  id           String   @id @default(cuid())
  userId       String
  firstName    String
  lastName     String
  phone        String
  email        String?
  address      String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  profileImage String?
  zipCode      String?
  Order        Order[]
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model PhoneResetOtp {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expires   DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
}

model MerchantProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  fullName         String   @db.VarChar(120)
  dateOfBirth      DateTime
  contactEmail     String   @db.VarChar(190)
  contactPhone     String   @db.VarChar(32)
  nidOrPassportNo  String   @db.VarChar(64)
  presentAddress   String   @db.VarChar(255)
  permanentAddress String   @db.VarChar(255)
  portfolioUrl     String?  @db.VarChar(255)
  websiteUrl       String?  @db.VarChar(255)
  bankName         String   @db.VarChar(80)
  bankBranch       String   @db.VarChar(80)
  accountName      String   @db.VarChar(120)
  accountNumber    String   @db.VarChar(64)
  routingNumber    String   @db.VarChar(64)
  message          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tiar             Int      @default(10)
  brandOption      Boolean  @default(false)
  leftTiar         Int      @default(0)
  zipCode          String?
  country          String?
  dailyLimitPct    Int?     @default(10)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bankName, bankBranch])
}

model Brand {
  id                 String              @id @default(uuid())
  name               String
  userId             String              @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  isActive           Boolean             @default(false)
  brandCategoryId    String?
  defaultBrandPct    Float               @default(10.0)
  defaultMerchantPct Float               @default(10.0)
  accountName        String              @db.VarChar(120)
  accountNumber      String              @db.VarChar(64)
  bankBranch         String              @db.VarChar(80)
  bankName           String              @db.VarChar(80)
  contactEmail       String              @db.VarChar(190)
  contactPhone       String              @db.VarChar(32)
  dateOfBirth        DateTime
  message            String?
  nidOrPassportNo    String              @db.VarChar(64)
  permanentAddress   String              @db.VarChar(255)
  portfolioUrl       String?             @db.VarChar(255)
  presentAddress     String              @db.VarChar(255)
  routingNumber      String              @db.VarChar(64)
  socialProfile      String
  websiteUrl         String?             @db.VarChar(255)
  industryType       String
  country            String?
  zipCode            String?
  isExclusive        Boolean             @default(false)
  bannerImage        String?             @db.VarChar(255)
  facebookLink       String?             @db.VarChar(255)
  instagramLink      String?             @db.VarChar(255)
  linkedinLink       String?             @db.VarChar(255)
  twitterLink        String?             @db.VarChar(255)
  bannerPosition     String?             @default("50")
  productCategoryId  String?
  brandCategory      BrandCategory?      @relation(fields: [brandCategoryId], references: [id])
  ProductCategory    ProductCategory?    @relation(fields: [productCategoryId], references: [id])
  user               User                @relation(fields: [userId], references: [id])
  BrandFollow        BrandFollow[]
  CommissionSetting  CommissionSetting[]
  Payout             Payout[]            @relation("BrandPayouts")
  Product            Product[]
  Sales              Sale[]              @relation("BrandSales")
}

model BrandCategory {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Brand     Brand[]
}

model Product {
  id                    String              @id @default(uuid())
  title                 String
  description           String?
  price                 Float
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  brandCommissionPct    Float?
  brandId               String?
  brandName             String?
  merchantCommissionPct Float?
  mockupId              String?
  userId                String
  isActive              Boolean             @default(false)
  visibility            Boolean             @default(true)
  backDesign            String?
  frontDesign           String?
  productId             String              @unique
  status                ProductStat?        @default(UNDERREVIEW)
  CommissionSetting     CommissionSetting[]
  features              Feature[]
  Brand                 Brand?              @relation(fields: [brandId], references: [id])
  Mockup                Mockup?             @relation(fields: [mockupId], references: [id])
  User                  User                @relation(fields: [userId], references: [id])
  variants              ProductVariant[]
  sales                 Sale[]
  tags                  Tag[]
  categories            ProductCategory[]   @relation("ProductCategories")

  @@index([isActive, visibility, createdAt])
  @@index([isActive, visibility, price])
  @@index([brandId])
  @@index([mockupId])
  @@index([userId])
  @@index([createdAt])
}

model ProductCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sortOrder Int?      @default(0)
  slug      String?   @unique
  isActive  Boolean   @default(true)
  Brand     Brand[]
  products  Product[] @relation("ProductCategories")

  @@index([slug])
}

model Sale {
  id              String     @id @default(uuid())
  productId       String
  merchantId      String
  brandId         String?
  quantity        Int        @default(1)
  total           Float
  brandEarning    Float      @default(0)
  merchantEarning Float      @default(0)
  platformEarning Float      @default(0)
  createdAt       DateTime   @default(now())
  orderItemId     String     @unique
  Refund          Refund[]
  brand           Brand?     @relation("BrandSales", fields: [brandId], references: [id])
  merchant        User       @relation("MerchantSales", fields: [merchantId], references: [id])
  orderItem       OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product         Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  SaleItem        SaleItem[]

  @@index([productId, createdAt])
}

model SaleItem {
  id          String  @id @default(uuid())
  saleId      String
  productId   String
  quantity    Int
  orderItemId String  @unique
  total       Decimal
  unitPrice   Decimal
  Sale        Sale    @relation(fields: [saleId], references: [id])
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  color     String   @db.VarChar(24)
  fitType   FitType
  backImg   String?
  frontImg  String?
  isActive  Boolean? @default(false)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, color, fitType])
  @@index([productId])
  @@index([fitType])
  @@index([color])
  @@index([fitType, color])
}

model Feature {
  id        String  @id @default(uuid())
  productId String
  content   String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Tag {
  id        String  @id @default(uuid())
  productId String
  value     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([value])
}

model Mockup {
  id        String          @id @default(uuid())
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  variants  MockupVariant[]
  Product   Product[]
}

model MockupVariant {
  id        String   @id @default(uuid())
  mockupId  String
  color     String   @db.VarChar(24)
  frontImg  String?
  backImg   String?
  fitType   FitType
  isVisible Boolean? @default(true)
  mockup    Mockup   @relation(fields: [mockupId], references: [id], onDelete: Cascade)

  @@unique([mockupId, color, fitType])
  @@index([mockupId, isVisible])
}

model Order {
  id             String        @id @default(cuid())
  currency       String        @default("BDT")
  tranId         String        @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  addressId      String?
  couponCode     String?
  couponRate     Decimal?      @db.Decimal(5, 4)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal       @db.Decimal(12, 2)
  shippingFee    Decimal       @default(0) @db.Decimal(12, 2)
  subtotal       Decimal       @db.Decimal(12, 2)
  tax            Decimal       @default(0) @db.Decimal(12, 2)
  userId         String?
  settledAt      DateTime?
  cancelledAt    DateTime?
  guestAddressId String?
  status         OrderStatus   @default(PENDING)
  address        UserAddress?  @relation(fields: [addressId], references: [id])
  GuestAddress   GuestAddress? @relation(fields: [guestAddressId], references: [id])
  user           User?         @relation(fields: [userId], references: [id])
  items          OrderItem[]
  payment        Payment?

  @@index([userId, createdAt])
  @@index([addressId])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  productId    String?
  productTitle String
  unitPrice    Decimal  @db.Decimal(12, 2)
  quantity     Int      @default(1)
  color        String?
  fitType      FitType?
  size         String?
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  Refund       Refund?
  Sale         Sale?
}

model Payment {
  id         String   @id @default(cuid())
  orderId    String   @unique
  valId      String?
  bankTranId String?
  cardType   String?
  rawPayload Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model CommissionSetting {
  id                       String    @id @default(uuid())
  brandId                  String?
  merchantId               String?
  brandCommissionPct       Float     @default(6.0)
  merchantCommissionPct    Float     @default(11.0)
  productId                String?
  effectiveFrom            DateTime  @default(now())
  effectiveTo              DateTime?
  isActive                 Boolean   @default(true)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  brandSelectedMerchantPct Float     @default(6.0)
  brand                    Brand?    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  merchant                 User?     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product                  Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([brandId, merchantId, productId])
}

model Refund {
  id              String    @id @default(uuid())
  orderItemId     String    @unique
  saleId          String?
  quantity        Int
  amount          Decimal   @db.Decimal(12, 2)
  brandEarning    Decimal   @db.Decimal(12, 2)
  merchantEarning Decimal   @db.Decimal(12, 2)
  platformEarning Decimal   @db.Decimal(12, 2)
  reason          String?
  createdAt       DateTime  @default(now())
  orderItem       OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  sale            Sale?     @relation(fields: [saleId], references: [id])

  @@index([saleId])
}

model Payout {
  id         String      @id @default(uuid())
  actor      PayoutActor
  brandId    String?
  merchantId String?
  amount     Decimal     @db.Decimal(12, 2)
  note       String?
  createdAt  DateTime    @default(now())
  brand      Brand?      @relation("BrandPayouts", fields: [brandId], references: [id])
  merchant   User?       @relation("MerchantPayouts", fields: [merchantId], references: [id])

  @@index([actor, brandId, merchantId, createdAt])
}

model GuestAddress {
  id        String   @id
  firstName String
  lastName  String
  phone     String
  email     String?
  address   String
  zipCode   String?
  createdAt DateTime @default(now())
  Order     Order[]
}

model BrandFollow {
  id        String   @id
  userId    String
  brandId   String
  createdAt DateTime @default(now())
  Brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, brandId])
  @@index([brandId])
  @@index([userId])
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  SHIPPED
  COMPLETED
}

enum ProductStat {
  UNDERREVIEW
  PROCESSING
  ACTIVE
  REJECT
}

enum PayoutActor {
  BRAND
  MERCHANT
}

enum FitType {
  MEN
  WOMEN
  YOUTH
}

enum Role {
  USER
  ADMIN
  BRAND
  MERCH
}

enum Visibility {
  SEARCHABLE
  NON_SEARCHABLE
}

enum ImageType {
  FRONT
  BACK
}
